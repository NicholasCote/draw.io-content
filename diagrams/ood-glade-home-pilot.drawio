<mxfile host="app.diagrams.net" version="26.1.1">
  <diagram name="OOD GLADE Home Pilot" id="ood-glade-home-pilot">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== Outside the cluster ===================== -->
        <mxCell id="user1" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Pilot User&lt;/font&gt;" style="shape=actor;whiteSpace=wrap;html=1;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
